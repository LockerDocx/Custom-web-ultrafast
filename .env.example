# ==============================================================================
# Jev Ultrafast Multi-Provider Configuration
# ==============================================================================

# Choose primary LLM provider: openrouter | omniroute | nvidia | anthropic | openai | typesafe
LLM_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# 1. OpenRouter (https://openrouter.ai)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 2. OmniRoute (Open source AI Gateway, default local port 20128)
# ------------------------------------------------------------------------------
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. NVIDIA NIM (https://integrate.api.nvidia.com)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# 4. Anthropic Claude (https://api.anthropic.com)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ------------------------------------------------------------------------------
# 5. OpenAI (https://api.openai.com)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 6. TypeSafe Jev (Legacy classification model)
# ------------------------------------------------------------------------------
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Secondary text model (optional fallback for TYPE_TEXT if using TypeSafe)
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=deepseek/deepseek-chat
TEXT_MODEL_REASONING=none
