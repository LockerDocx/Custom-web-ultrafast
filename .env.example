# ─────────────────────────────────────────────────────────────────────────────
# Jev Ultrafast · settings
#
# ONE free key is enough: the agent derives every provider and model from it.
#   Groq        (fastest executor)   https://console.groq.com/keys
#   NVIDIA NIM  (deeper planner)     https://build.nvidia.com
#
# Both keys → NVIDIA plans each mission, Groq executes every step (fastest
#             measured arrangement).
# One key   → that provider runs all three roles.
#
# The Firefox sidebar asks for the key the first time you open it (and keeps it
# here), so you normally never edit this file by hand. Anything below is optional.
# ─────────────────────────────────────────────────────────────────────────────

GROQ_API_KEY=
NVIDIA_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# TypeSafe Jev instead of the policy model ...... TYPESAFE_API_KEY=
# Pin a provider or model per role ............ POLICY_PROVIDER=openai  POLICY_MODEL=gpt-5-mini
#                                                PLANNER_PROVIDER=  PLANNER_MODEL=  TEXT_MODEL=
# Per-model parameters (or use the sidebar) .... POLICY_TEMPERATURE=0.2  POLICY_REASONING=low
# Isolated browser (Docker) .................... NEKO_*  JEV_BROWSER_MODE=sandbox
# Host allowlist for network tools ............. JEV_ALLOWED_HOSTS=docs.python.org
# Permission levels (sidebar) .................. JEV_PERMISSIONS=artifacts/permissions.json
# Bridge port / shared secret .................. FIREFOX_BRIDGE_PORT=8767  FIREFOX_BRIDGE_TOKEN=
#
# Full list, with what each one does: docs/providers.md (Environment reference)
