{
  "manifest_version": 2,
  "name": "Ultrafast Web Agent",
  "version": "1.0.0",
  "description": "Agente web autónomo ultrarrápido con soporte multi-proveedor (OpenRouter, OmniRoute, NVIDIA NIM, Anthropic, OpenAI).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "<all_urls>",
    "webNavigation"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Ultrafast Web Agent"
  },
  "background": {
    "scripts": [
      "background/providers.js",
      "background/background.js"
    ],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ultrafast-agent@arena.ai",
      "strict_min_version": "109.0"
    }
  }
}
